flowchart TB
    %% ============================================================
    %%  git-logs — SQLite Split-DB Design (proposed)
    %%
    %%  Pattern:  Root DB (one)  +  Logs DB (one per repository)
    %%  Aligns with spec/05-split-db-architecture
    %%  Seeded on first run per spec/06-seedable-config-architecture
    %%
    %%  NOTE: existing 02-database-schema-and-erd.md is the MySQL/WP
    %%  contract. This diagram is the SQLite re-cast for self-hosted
    %%  / CLI deployments. Tables are PascalCase (no underscores) per
    %%  split-DB rule.
    %% ============================================================

    %% -------- File system layout --------
    subgraph FS["<b>File System Layout (per project)</b>"]
        direction TB
        FS1["<code>./data/</code>"]:::folder
        FS2["<code>./data/root.db</code><br/><i>App metadata, users, repo allowlist, audit</i>"]:::rootDb
        FS3["<code>./data/logs/</code>"]:::folder
        FS4["<code>./data/logs/repo-00001-acme-widget.db</code>"]:::logDb
        FS5["<code>./data/logs/repo-00002-acme-widget-v2.db</code>"]:::logDb
        FS6["<code>./data/logs/repo-00003-other-tool.db</code>"]:::logDb
        FS7["<code>./config/config.seed.json</code><br/><i>Versioned defaults (CW Config)</i>"]:::cfg
        FS1 --> FS2
        FS1 --> FS3
        FS3 --> FS4
        FS3 --> FS5
        FS3 --> FS6
    end

    %% -------- Root DB --------
    subgraph ROOT["<b>Root DB — root.db</b><br/><i>One per installation</i>"]
        direction TB
        T_USER["<b>User</b><br/>UserId PK · Username UQ<br/>DisplayName · Email<br/>TokenHash (Argon2id)<br/>UserStatusId · IsLocked<br/>HasWordPressBridge<br/>CreatedAt · UpdatedAt"]:::tEntity
        T_ROLE["<b>UserRole</b><br/>UserRoleId PK<br/>UserId FK · RoleId FK<br/>ScopeJson · CreatedAt"]:::tEntity
        T_REFRESH["<b>RefreshToken</b><br/>RefreshTokenId PK<br/>UserId FK · TokenHash<br/>TokenLookupHash UQ<br/>RotatedFromRefreshTokenId FK<br/>IsRevoked · IsRotated<br/>ExpiresAt · CreatedAt"]:::tTxn
        T_REPO["<b>Repository</b><br/>RepositoryId PK<br/>ProviderId · OwnerName · RepoName<br/>AcceptanceModeId · VersionModeId<br/>RepositoryStatusId<br/>LogSenderTokenHash<br/><b>LogsDbPath</b> (relative, e.g. logs/repo-00001-…db)<br/>CreatedAt · UpdatedAt"]:::tEntity
        T_AUDIT["<b>AuditTrail</b><br/>AuditTrailId PK<br/>ActorUserId FK NULL · RepositoryId FK NULL<br/>ActionId · OutcomeId · TraceId<br/>DetailsJson · OccurredAt"]:::tTxn
        T_DENY["<b>JwtDenylist</b><br/>JwtDenylistId PK<br/>Jti UQ · Sub<br/>RevokedAt · ExpiresAt · ReasonId"]:::tTxn
        T_KEY["<b>JwtKey</b><br/>JwtKeyId PK<br/>Kid UQ · StateId (Active/Retiring)<br/>PublicKeyPem · PrivateKeyEnc<br/>CreatedAt · RetiringSince"]:::tTxn
        T_CFG["<b>AppConfig</b><br/>AppConfigId PK<br/>SchemaVersion · ConfigJson<br/>SeedVersion · UpdatedAt<br/><i>(seeded from config.seed.json)</i>"]:::tCfg

        %% Lookup tables
        T_LK1["<b>UserStatus</b><br/>Active · Disabled · Pending"]:::tLookup
        T_LK2["<b>Role</b><br/>UserAdmin · RepoAdmin<br/>LogReader · Auditor"]:::tLookup
        T_LK3["<b>Provider</b><br/>GitHub · GitLab(reserved)"]:::tLookup
        T_LK4["<b>AcceptanceMode</b><br/>RepoUrl · OwnerWildcard"]:::tLookup
        T_LK5["<b>VersionMode</b><br/>Exact · Wildcard"]:::tLookup
        T_LK6["<b>RepositoryStatus</b><br/>Active · Disabled"]:::tLookup
        T_LK7["<b>AuditAction</b><br/>UserCreate · TokenIssue<br/>LogPush · LogQuery · …"]:::tLookup
        T_LK8["<b>AuditOutcome</b><br/>Success · Rejected · Error"]:::tLookup
        T_LK9["<b>JwtKeyState</b><br/>Active · Retiring · Retired"]:::tLookup

        %% Relationships
        T_USER --o T_ROLE
        T_USER --o T_REFRESH
        T_USER --o T_AUDIT
        T_REPO --o T_AUDIT
        T_USER --> T_LK1
        T_ROLE --> T_LK2
        T_REPO --> T_LK3
        T_REPO --> T_LK4
        T_REPO --> T_LK5
        T_REPO --> T_LK6
        T_AUDIT --> T_LK7
        T_AUDIT --> T_LK8
        T_KEY --> T_LK9
    end

    %% -------- Per-repo Logs DB (template) --------
    subgraph LOGDB["<b>Logs DB — logs/repo-{id}-{owner}-{repo}.db</b><br/><i>One per allowlisted repository · WAL mode</i>"]
        direction TB
        L_META["<b>RepositoryMeta</b><br/>RepositoryMetaId PK (always 1)<br/>RootRepositoryId · OwnerName · RepoName<br/>SchemaVersion · CreatedAt<br/><i>(self-describing — survives detach/reattach)</i>"]:::tCfg
        L_PIPE["<b>Pipeline</b><br/>PipelineId PK<br/>BranchName · PipelineName<br/>UQ(BranchName, PipelineName)<br/>FirstSeenAt · LastSeenAt"]:::tEntity
        L_ENTRY["<b>LogEntry</b><br/>LogEntryId PK<br/>PipelineId FK<br/>LogSeverityId · CommitSha<br/>Message · MetadataJson<br/>OccurredAt · CreatedAt<br/><i>BIGINT PK · expected > 2 B rows</i>"]:::tTxn
        L_NONCE["<b>EnvelopeNonce</b><br/>EnvelopeNonceId PK<br/>Nonce UQ · ReceivedAt<br/><i>10-min replay window<br/>swept by background job</i>"]:::tTxn
        L_LK1["<b>LogSeverity</b><br/>Trace · Debug · Info<br/>Warn · Error · Fatal"]:::tLookup

        L_PIPE --o L_ENTRY
        L_ENTRY --> L_LK1
    end

    %% -------- Cross-DB virtual link --------
    T_REPO -. "LogsDbPath<br/>(soft FK across files)" .-> LOGDB
    L_META -. "RootRepositoryId<br/>(back-reference)" .-> T_REPO

    %% -------- Seedable config flow --------
    FS7 ==>|"first run<br/>seeder"| T_CFG
    FS7 ==>|"first run<br/>seeder"| T_LK1
    FS7 ==>|"first run<br/>seeder"| T_LK2
    FS7 ==>|"first run<br/>seeder"| T_LK3
    FS7 ==>|"first run<br/>seeder"| T_LK4
    FS7 ==>|"first run<br/>seeder"| T_LK5
    FS7 ==>|"first run<br/>seeder"| T_LK6
    FS7 ==>|"first run<br/>seeder"| T_LK7
    FS7 ==>|"first run<br/>seeder"| T_LK8
    FS7 ==>|"first run<br/>seeder"| T_LK9
    FS7 ==>|"first run<br/>seeder"| L_LK1

    %% -------- Lifecycle: repo create --------
    REPO_CREATE["<b>Lifecycle:</b> POST /repositories"]:::lifecycle
    REPO_CREATE -->|"1 INSERT Repository<br/>(LogsDbPath = NULL)"| T_REPO
    REPO_CREATE -->|"2 mkdir + create<br/>logs/repo-{id}-…db<br/>via schema migration"| LOGDB
    REPO_CREATE -->|"3 UPDATE Repository<br/>SET LogsDbPath = '…'"| T_REPO
    REPO_CREATE -->|"4 INSERT AuditTrail"| T_AUDIT

    %% ==================== STYLES ====================
    classDef folder    fill:#1e293b,stroke:#64748b,stroke-width:1px,color:#cbd5e1,font-family:monospace
    classDef rootDb    fill:#0f766e,stroke:#5eead4,stroke-width:2px,color:#ccfbf1,font-weight:bold
    classDef logDb     fill:#831843,stroke:#f472b6,stroke-width:2px,color:#fce7f3,font-weight:bold
    classDef cfg       fill:#365314,stroke:#a3e635,stroke-width:2px,color:#ecfccb

    classDef tEntity   fill:#1e3a8a,stroke:#60a5fa,stroke-width:1.5px,color:#dbeafe
    classDef tTxn      fill:#7c2d12,stroke:#fb923c,stroke-width:1.5px,color:#fed7aa
    classDef tLookup   fill:#3f3f46,stroke:#a1a1aa,stroke-width:1px,color:#f4f4f5
    classDef tCfg      fill:#365314,stroke:#a3e635,stroke-width:1.5px,color:#ecfccb

    classDef lifecycle fill:#0f172a,stroke:#fbbf24,stroke-width:2px,color:#fbbf24,font-weight:bold
