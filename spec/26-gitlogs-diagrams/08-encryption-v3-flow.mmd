%% Encryption-at-rest (v3 deferred plan)
%% Source: spec/22-git-logs-v2/11-encryption-deferred-plan.md

flowchart TD
    A[Install / Upgrade to v3] --> B{GITLOGS_MASTER_KEY env set?}
    B -- no --> B1[Abort migration with clear error]
    B -- yes --> C[Store MasterKey in WP option]
    C --> D[Generate DataKey]
    D --> E[Wrap DataKey with MasterKey]
    E --> F[Save WrappedDataKey in ConfigKv]
    F --> G[Derive LookupKey via HKDF MasterKey, label gitlogs/lookup/v1]

    G --> H[ALTER Profile ADD TempTokenLookupHash TEXT]
    H --> I[For each Profile row]
    I --> J[Encrypt TempToken with DataKey AES-256-GCM]
    I --> K[Compute HMAC-SHA256 TempToken, LookupKey]
    J --> L[UPDATE Profile.TempToken = ciphertext]
    K --> M[UPDATE Profile.TempTokenLookupHash = hmac]
    I --> N[Hash GeneratedKeyApi + Token with Argon2id]
    N --> O[UPDATE Profile.GeneratedKeyApi, Token = hash]

    L --> P[INSERT MigrationState PluginVersion=3.0.0]
    M --> P
    O --> P
    P --> Q[v3 ready: lookup-by-hash, decrypt-on-match]
